APP_NAME="AutoShop Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database (MySQL 8+ / MariaDB 10.6+) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoshop
DB_USERNAME=autoshop
DB_PASSWORD=
# InnoDB is required (transactions + foreign keys). Do not use MyISAM.
DB_ENGINE=InnoDB

# ---- Sessions (database driver enables "active sessions" management) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS required)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Run `php artisan queue:work` (or Supervisor) for emails / notifications
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Mail (can also be overridden from Settings > Email) ----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Integrations (optional; Settings > Integrations values take precedence) ----
NHTSA_VPIC_URL=https://vpic.nhtsa.dot.gov/api/vehicles
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---- Backups ----
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_KEEP_DAYS=14

VITE_APP_NAME="${APP_NAME}"
